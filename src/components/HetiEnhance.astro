---
/**
 * 赫蹏（heti）客户端增强。
 *
 * `autoSpacing()` 会在正文里插入 `<heti-spacing>` 与 `heti-adjacent` 元素：
 * 前者负责中西文混排间距，后者负责全角标点挤压，两者都依赖 heti.css 里的规则，
 * 且只在 `.heti` 容器内生效——所以样式和容器类缺一不可。
 *
 * 脚本只在含正文的页面渲染，列表页不会加载。
 */
---

<script>
  import Heti from 'heti/js/heti-addon.js';

  if (document.querySelector('.heti')) {
    // 长文（本站最长一篇正文约 8 万字）遍历开销明显，放到空闲时段避免阻塞首屏
    const run = () => new Heti('.heti').autoSpacing();
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(run, { timeout: 2000 });
    } else {
      setTimeout(run, 200);
    }
  }
</script>
